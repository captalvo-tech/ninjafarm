{
    "name": "ninja-farm",
    "version": "0.1.0",
    "private": true,
    "description": "Ninja Farm - 3D Browser Game (PlayCanvas standalone + TypeScript + Vite)",
    "type": "module",
    "scripts": {
        "build": "vite build",
        "check:roadmap": "tsx scripts/validate-roadmap.ts",
        "dev": "vite",
        "fmt": "prettier --check .",
        "fmt:fix": "prettier --write .",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "start": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "playcanvas": "^2.23.3"
    },
    "devDependencies": {
        "@playcanvas/eslint-config": "3.0.0",
        "@playcanvas/inspector": "^0.4.0",
        "@types/node": "^26.6.6",
        "eslint": "^9.39.5",
        "prettier": "^3.9.10",
        "tsx": "^4.23.15",
        "typescript": "~6.0.3",
        "vite": "^8.3.5",
        "vitest": "^3.0.0"
    },
    "engines": {
        "node": ">=22.23.2"
    }
}
